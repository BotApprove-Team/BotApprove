[Unit]
Description=BotApprove database snapshot
Documentation=https://botapprove.mikuuu.xyz
# Ordering only. The snapshot is safe against a live database and is also worth
# taking when the bot is down, so this deliberately does not Require= it.
After=botapprove.service

[Service]
User=botapprove
Group=botapprove
Type=oneshot
WorkingDirectory=/opt/botapprove
ExecStart=/usr/bin/node scripts/backup.js
EnvironmentFile=/opt/botapprove/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=botapprove-backup

UMask=0077
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/botapprove/data
