[Unit]
Description=BotApprove — Discord bot approval gate
Documentation=https://botapprove.mikuuu.xyz
After=network-online.target
Wants=network-online.target
# Rate limiting lives in [Unit]; systemd ignores these under [Service].
# A security bot that cannot start should stay down loudly rather than flap.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
User=botapprove
Group=botapprove
Type=simple
WorkingDirectory=/opt/botapprove
ExecStart=/usr/bin/node src/index.js
EnvironmentFile=/opt/botapprove/.env
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=botapprove

UMask=0077
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Must already exist: the mount namespace is set up before any Exec* runs, so
# a missing directory fails the unit with 226/NAMESPACE rather than creating it.
# The account is read by systemd, not by the app, so .env stays root-owned and
# the service user never gets to read the token off disk.
#   useradd --system --no-create-home --shell /usr/sbin/nologin botapprove
#   mkdir -p /opt/botapprove/data
#   chown -R botapprove:botapprove /opt/botapprove/data
ReadWritePaths=/opt/botapprove/data

[Install]
WantedBy=multi-user.target
