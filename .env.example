# ---- Discord application ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---- Web interface ----
WEB_ENABLED=true
WEB_PORT=8420
WEB_HOST=127.0.0.1
# Public origin, no trailing slash. The Discord OAuth redirect must be
# <BASE_URL>/auth/callback and be registered in the Discord developer portal.
BASE_URL=https://botapprove.mikuuu.xyz
# openssl rand -hex 32
SESSION_SECRET=
# Behind Caddy: trust one proxy hop, for secure cookies and a real client IP.
TRUST_PROXY=1

# ---- Storage ----
DATABASE_PATH=./data/botapprove.db

# ---- Operator ----
# Discord user ids with access to /admin and the /license generate command.
# Their servers also bypass the paywall.
OWNER_IDS=
# Servers that are always licensed regardless of the paywall (your own).
FREE_GUILD_IDS=

# ---- Operator elevation ----
# scrypt "salt:key", never the password itself. Generate with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" 'yourpassword'
# Two different passwords, asked one after the other. Both must be set, or
# elevation stays unavailable rather than falling back to a single factor.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_HASH_2=
ADMIN_UNLOCK_MINUTES=30
# Seconds the first password stays accepted before the sequence restarts.
ADMIN_STAGE_SECONDS=120

# ---- Stripe ----
# Flip to true only when the Stripe account review has cleared.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Optional. Each enables that plan; leave blank and it is not offered.
STRIPE_PRICE_ID_YEARLY=
STRIPE_PRICE_ID_LIFETIME=
# Shown on the pricing page. The real amounts live in Stripe.
PRICE_AMOUNT_YEARLY=50
PRICE_AMOUNT_LIFETIME=150
# How many lifetime licences may be sold in total. 0 means no limit. Only paid
# purchases count; complimentary perpetual keys do not consume a place.
LIFETIME_CAP=0
STRIPE_PORTAL_URL=
# Free days attached to a new subscription at checkout, advertised on /pricing.
# Separate from TRIAL_DAYS below, which hands out a trial on install and is off.
# 0 removes the offer. Once per server either way.
STRIPE_TRIAL_DAYS=7
STRIPE_WEBHOOK_SECRET=

# ---- Paywall ----
# Keep false for private use. When true, unlicensed servers keep the FULL core
# guard (gate, default keywords, audit trail, tamper detection) forever — only
# premium features switch off, and the owner is DMed exactly what stopped.
PAYWALL_ENABLED=false
# 0 = new servers get no trial and start on the free tier. Any positive
# number puts every newly added server on a trial of that many days.
TRIAL_DAYS=0
PURCHASE_URL=

# ---- Behaviour ----
NODE_ENV=production
# The bot's custom status. Defaults to the BASE_URL host if unset.
BOT_STATUS=botapprove.mikuuu.xyz
LOG_LEVEL=info
# Minutes a re-invite token stays valid after a keyword-flagged bot is approved.
REINVITE_TOKEN_TTL_MINUTES=12

# ---- Legal and contact ----
# Shown on the Terms and Privacy pages, and where sold-out enquiries are sent.
LEGAL_OPERATOR=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_URL=
LEGAL_UPDATED=
