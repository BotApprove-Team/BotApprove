<%- include('partials/head') %>
<%
  const badge = (tone, icon, text) =>
    `<span class="badge ${tone}"><svg aria-hidden="true"><use href="#${icon}"></use></svg>${text}</span>`;
%>

<header class="page-head">
  <h1>Servers</h1>
  <p class="lede">
    <%= guilds.length %> visible to you<% if (asRp) { %>, showing where RaidProtector is<% } %>.
  </p>
</header>

<% if (asRp && rpProblem) { %>
  <div class="notice warn">
    <strong>RaidProtector is not answering</strong>
    <p><%= rpProblem %> The list below still shows your servers, it just cannot say which of them
      have raid protection running.</p>
  </div>
<% } %>

<% if (flash) { %>
  <div class="notice <%= flash.type === 'error' ? 'danger' : 'ok' %>"><%= flash.message %></div>
<% } %>

<% if (guilds.length) { %>
  <ul class="server-list">
    <% guilds.forEach((g) => { %>
      <li>
        <span class="server-icon" aria-hidden="true">
          <% if (g.icon) { %>
            <img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png?size=64" alt="" width="40" height="40">
          <% } else { %><%= g.name.slice(0, 1).toUpperCase() %><% } %>
        </span>
        <div class="server-name">
          <p><%= g.name %></p>
          <code><%= g.id %></code>
        </div>
        <div class="server-state">
          <% if (asRp) { %>
            <% if (g.rpPresent === false) { %>
              <%- badge('neutral', 'i-off', 'Not installed') %>
              <% if (g.manageable && rpInviteUrl) { %>
                <a class="btn" href="<%= rpInviteUrl %>&guild_id=<%= g.id %>">Add RaidProtector</a>
              <% } %>
            <% } else if (g.rpPresent) { %>
              <%- badge('ok', 'i-ok', 'Protected') %>
              <a class="btn" href="/g/<%= g.id %>/raidprotector">Open</a>
            <% } else { %>
              <%- badge('neutral', 'i-info', 'Unknown') %>
              <% if (g.botPresent) { %><a class="btn" href="/g/<%= g.id %>/raidprotector">Open</a><% } %>
            <% } %>
          <% } else if (!g.botPresent) { %>
            <%- badge('neutral', 'i-off', 'Not installed') %>
            <% if (g.manageable) { %>
              <a class="btn" href="<%= inviteUrl %>&guild_id=<%= g.id %>">Add BotApprove</a>
            <% } %>
          <% } else { %>
            <%- badge('ok', 'i-ok', g.manageable ? 'You manage it' : 'You approve here') %>
            <a class="btn" href="/g/<%= g.id %>">Open</a>
          <% } %>
        </div>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p class="empty">No servers found. Add BotApprove to a server you manage first, then sign in again.</p>
<% } %>

<section class="band split" aria-labelledby="add-title">
  <div class="split-lead">
    <h2 id="add-title">Adding it to a server</h2>
  </div>
  <div>
    <% if (asRp) { %>
      <p class="lede">
        RaidProtector needs <code>Moderate Members</code> to time people out, and
        <code>Ban Members</code> only if you turn bans on. Its role must sit above the people it
        may act on. It is a separate install from BotApprove and starts in report mode, acting on
        nobody until you say otherwise.
      </p>
      <div class="cta">
        <% if (rpInviteUrl) { %><a class="btn btn-primary" href="<%= rpInviteUrl %>">Invite RaidProtector</a><% } %>
        <a class="btn" href="/raidprotector">What it does</a>
      </div>
    <% } else { %>
      <p class="lede">
        BotApprove needs <code>Kick Members</code>, <code>Ban Members</code>,
        <code>View Audit Log</code> and <code>Change Nickname</code>. Its role must sit above where
        new bots land, and it needs <code>View Channel</code> in whichever channel you point it at.
      </p>
      <div class="cta"><a class="btn btn-primary" href="<%= inviteUrl %>">Invite BotApprove</a></div>
    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
