<% const prod = (typeof product !== 'undefined' && product) ? product : 'botapprove'; %>
<% const rpPage = prod === 'raidprotector'; %>
<!doctype html>
<html lang="en"<% if (rpPage) { %> data-product="raidprotector"<% } %><%
  if (typeof claudeVisitor !== 'undefined' && claudeVisitor) { %> data-visitor="claude"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="<%= indexable ? 'index, follow' : 'noindex, nofollow' %>">
  <title><%= title === 'BotApprove' ? title : `${title} · BotApprove` %></title>
<%
  const ogTitle = typeof cardTitle !== 'undefined' && cardTitle
    ? cardTitle
    : (title === 'BotApprove' ? 'BotApprove' : `${title} · BotApprove`);
  const ogDescription = typeof cardDescription !== 'undefined' && cardDescription
    ? cardDescription
    : 'Every bot that joins your Discord server is kicked on sight and held for human '
      + 'approval, whoever invited it. Anti-nuke protection that acts before the damage.';
  const ogImage = `${baseUrl}/static/banner.png`;
%>
  <meta name="description" content="<%= ogDescription %>">
  <link rel="canonical" href="<%= baseUrl %><%= path %>">

  <meta property="og:site_name" content="BotApprove">
  <meta property="og:type" content="<%= typeof cardType !== 'undefined' ? cardType : 'website' %>">
  <meta property="og:url" content="<%= baseUrl %><%= path %>">
  <meta property="og:title" content="<%= ogTitle %>">
  <meta property="og:description" content="<%= ogDescription %>">
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:image:width" content="1920">
  <meta property="og:image:height" content="1080">
  <meta property="og:image:alt" content="BotApprove, no bot gets in without a human saying yes">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= ogTitle %>">
  <meta name="twitter:description" content="<%= ogDescription %>">
  <meta name="twitter:image" content="<%= ogImage %>">
  <!-- X reads this one, not og:image:alt. Without it a shared link is an
       undescribed image to anyone using a screen reader. -->
  <meta name="twitter:image:alt"
        content="Dark banner with the BotApprove shield and the line: no bot gets in without a human saying yes.">

  <!-- Discord tints the left edge of the embed with this. -->
  <meta name="theme-color" content="<%= rpPage ? '#c9a0f5' : '#5e9bff' %>">
  <link rel="preload" href="/static/fonts/IBMPlexSans-Regular-Latin1.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/IBMPlexSans-SemiBold-Latin1.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="icon" type="image/svg+xml" href="/static/icon.svg?v=<%= cssVersion %>">
  <script src="/static/theme.js?v=<%= cssVersion %>"></script>
  <link rel="stylesheet" href="/static/style.css?v=<%= cssVersion %>">
  <script src="/static/site.js?v=<%= cssVersion %>" defer></script>
</head>
<body>
<%- include('sprite') %>

<a class="skip" href="#main">Skip to content</a>

<% const goTo = (typeof switchTo !== 'undefined' && switchTo)
     ? switchTo : { botapprove: '/', raidprotector: '/raidprotector' }; %>
<% const here = typeof path !== 'undefined' ? path : ''; %>
<header class="site-head">
  <div class="wrap head-row">
    <a class="brand" href="<%= rpPage ? '/raidprotector' : '/' %>">
      <svg aria-hidden="true"><use href="#<%= rpPage ? 'm-rp' : 'm-ba' %>"></use></svg>
      <span><% if (rpPage) { %>raid<b>protector</b><% } else { %>bot<b>approve</b><% } %></span>
    </a>
    <nav class="prod-switch" aria-label="Choose a product">
      <a href="<%= goTo.botapprove %>"<% if (!rpPage) { %> aria-current="page"<% } %>>BotApprove</a>
      <a href="<%= goTo.raidprotector %>"<% if (rpPage) { %> aria-current="page"<% } %>>RaidProtector</a>
    </nav>
    <nav class="site-nav" id="site-nav" aria-label="Site">
      <% if (user) { %>
        <a href="/guilds"<% if (here === '/guilds' || here.startsWith('/g/')) { %> aria-current="page"<% } %>>Servers</a>
        <a href="/blog"<% if (here.startsWith('/blog')) { %> aria-current="page"<% } %>>Blog</a>
        <a href="/pricing"<% if (here === '/pricing') { %> aria-current="page"<% } %>>Pricing</a>
        <% if (isOwner) { %><a href="/admin"<% if (here.startsWith('/admin')) { %> aria-current="page"<% } %>>Admin</a><% } %>
        <span class="who"><%= user.globalName || user.username %></span>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn" type="submit">Sign out</button>
        </form>
      <% } else { %>
        <a href="/blog"<% if (here.startsWith('/blog')) { %> aria-current="page"<% } %>>Blog</a>
        <a href="/pricing"<% if (here === '/pricing') { %> aria-current="page"<% } %>>Pricing</a>
        <a class="btn signin" href="/login">Sign in with Discord</a>
      <% } %>
    </nav>
    <div class="head-tools" id="head-tools"></div>
  </div>
</header>
<%- include('legal-notice') %>
<main id="main">
  <div class="wrap">
