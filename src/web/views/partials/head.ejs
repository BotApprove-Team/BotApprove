<% const prod = (typeof product !== 'undefined' && product) ? product : 'botapprove'; %>
<!doctype html>
<html lang="en"<% if (prod === 'raidprotector') { %> data-product="raidprotector"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="<%= indexable ? 'index, follow' : 'noindex, nofollow' %>">
  <title><%= title === 'BotApprove' ? title : `${title} · BotApprove` %></title>
<%
  const ogTitle = typeof cardTitle !== 'undefined' && cardTitle
    ? cardTitle
    : (title === 'BotApprove' ? 'BotApprove' : `${title} · BotApprove`);
  const ogDescription = typeof cardDescription !== 'undefined' && cardDescription
    ? cardDescription
    : 'Every bot that joins your Discord server is kicked on sight and held for human '
      + 'approval, whoever invited it. Anti-nuke protection that acts before the damage.';
  const ogImage = `${baseUrl}/static/banner.png`;
%>
  <meta name="description" content="<%= ogDescription %>">
  <link rel="canonical" href="<%= baseUrl %><%= path %>">

  <meta property="og:site_name" content="BotApprove">
  <meta property="og:type" content="<%= typeof cardType !== 'undefined' ? cardType : 'website' %>">
  <meta property="og:url" content="<%= baseUrl %><%= path %>">
  <meta property="og:title" content="<%= ogTitle %>">
  <meta property="og:description" content="<%= ogDescription %>">
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:image:width" content="1920">
  <meta property="og:image:height" content="1080">
  <meta property="og:image:alt" content="BotApprove, no bot gets in without a human saying yes">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= ogTitle %>">
  <meta name="twitter:description" content="<%= ogDescription %>">
  <meta name="twitter:image" content="<%= ogImage %>">
  <!-- X reads this one, not og:image:alt. Without it a shared link is an
       undescribed image to anyone using a screen reader. -->
  <meta name="twitter:image:alt"
        content="Dark banner reading botapprove, no bot gets in without a human saying yes, with
                 labels for approval gate, keyword blocking and nuke bot database.">

  <!-- Discord tints the left edge of the embed with this. -->
  <meta name="theme-color" content="#5e9bff">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&display=swap">
  <link rel="icon" type="image/svg+xml" href="/static/icon.svg?v=<%= cssVersion %>">
  <script src="/static/theme.js?v=<%= cssVersion %>"></script>
  <link rel="stylesheet" href="/static/style.css?v=<%= cssVersion %>">
</head>
<body>
<header class="top">
  <div class="wrap">
    <a class="brand" href="<%= prod === 'raidprotector' ? '/raidprotector' : '/' %>">
      <svg class="mark" viewBox="0 0 32 32" width="18" height="18" aria-hidden="true">
        <g class="mark-one">
          <path d="M16 5.5l8.5 3.2v7.1c0 5.3-3.6 9.1-8.5 10.7-4.9-1.6-8.5-5.4-8.5-10.7V8.7L16 5.5z"
                fill="currentColor"/>
          <path d="M11.8 16.1l3 3 5.4-5.7" fill="none" stroke="var(--bg)" stroke-width="2.6"
                stroke-linecap="round" stroke-linejoin="round"/>
        </g>
        <g class="mark-wall">
          <path d="M9.4 9.2l4.8 2.1v4.65c0 3.45-2.02 6-4.8 7.05c-2.78-1.05-4.8-3.6-4.8-7.05V11.3L9.4 9.2z"
                fill="currentColor" opacity=".45"/>
          <path d="M22.6 9.2l4.8 2.1v4.65c0 3.45-2.02 6-4.8 7.05c-2.78-1.05-4.8-3.6-4.8-7.05V11.3L22.6 9.2z"
                fill="currentColor" opacity=".45"/>
          <path d="M16 7.4l5.8 2.52v5.58c0 4.14-2.44 7.2-5.8 8.46c-3.36-1.26-5.8-4.32-5.8-8.46V9.92L16 7.4z"
                fill="currentColor"/>
        </g>
      </svg>
      <span><% if (prod === 'raidprotector') { %>raid<b>protector</b><% } else { %>bot<b>approve</b><% } %></span>
    </a>
<% const goTo = (typeof switchTo !== 'undefined' && switchTo)
     ? switchTo : { botapprove: '/', raidprotector: '/raidprotector' }; %>
    <div class="prodpick" role="group" aria-label="Choose a product">
      <a href="<%= goTo.botapprove %>"<% if (prod !== 'raidprotector') { %> aria-current="page"<% } %>>BotApprove</a>
      <a href="<%= goTo.raidprotector %>"<% if (prod === 'raidprotector') { %> aria-current="page"<% } %>>RaidProtector</a>
    </div>
    <nav>
      <% if (user) { %>
        <a href="/guilds">Servers</a>
        <a href="/blog">Blog</a>
        <a href="/pricing">Pricing</a>
        <% if (isOwner) { %><a href="/admin">Admin</a><% } %>
        <span class="who"><%= user.globalName || user.username %></span>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="sm" type="submit">Sign out</button>
        </form>
      <% } else { %>
        <a href="/blog">Blog</a>
        <a href="/pricing">Pricing</a>
        <a class="btn sm" href="/login">Sign in with Discord</a>
      <% } %>
      <button id="theme-toggle" type="button" aria-label="Switch theme">
        <svg class="icon-sun" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
             fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.2"/>
          <path d="M12 2.4v2.3M12 19.3v2.3M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2.4 12h2.3M19.3 12h2.3M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7"/>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
             fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"
             stroke-linejoin="round">
          <path d="M20.5 14.3A8.5 8.5 0 1 1 9.7 3.5a6.9 6.9 0 0 0 10.8 10.8z"/>
        </svg>
      </button>
    </nav>
  </div>
</header>
<main>
  <div class="wrap">
