<% const onRp = (typeof product !== 'undefined' ? product : '') === 'raidprotector'; %>
<section class="band" aria-labelledby="suite-title">
  <div class="licence">
    <div class="licence-head">
      <div>
        <p class="form-label">Licence</p>
        <h2 id="suite-title">Protection Suite</h2>
      </div>
      <% if (typeof price !== 'undefined' && price) { %>
        <p class="licence-price"><strong><%= price.symbol %><%= price.amount %></strong> a month per server</p>
      <% } %>
    </div>
    <p class="licence-note">
      One licence covers a server in both bots, with one checkout.<% if (onRp) { %> While the beta
      runs, it is the only way to switch RaidProtector on.<% } %> Nothing that protects a server is
      ever behind the paywall. Premium adds extras, and the dashboard says which is which.
    </p>
    <ul class="products">
      <li>
        <span class="prod-mark ba"><svg aria-hidden="true"><use href="#m-ba"></use></svg></span>
        <div>
          <p class="prod-name">BotApprove <span class="badge">Live</span></p>
          <p>
            The gate, keyword blocking, the audit trail, tamper detection and the dashboard are
            free forever. Premium adds threat intelligence and automation.
          </p>
          <% if (onRp) { %><a href="/">How BotApprove works</a><% } %>
        </div>
      </li>
      <li>
        <span class="prod-mark rp"><svg aria-hidden="true"><use href="#m-rp"></use></svg></span>
        <div>
          <p class="prod-name">RaidProtector <span class="badge">Beta, Protection Suite only</span></p>
          <p>
            Raid detection, a response you can undo, and a record of every incident. Open to
            servers holding a licence while the beta runs.
          </p>
          <% if (!onRp) { %><a href="/raidprotector">How RaidProtector works</a><% } %>
        </div>
      </li>
    </ul>
    <a class="btn" href="/pricing">Compare Free and Protection Suite</a>
  </div>
</section>
