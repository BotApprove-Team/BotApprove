<% if (typeof legalNotice !== 'undefined' && legalNotice) { %>
  <%
    const rp = (typeof product !== 'undefined' ? product : '') === 'raidprotector';
    const termsHref = rp ? '/raidprotector/terms' : '/terms';
    const privacyHref = rp ? '/raidprotector/privacy' : '/privacy';
  %>
  <div class="legal-notice" id="legal-notice" data-version="<%= legalNotice.version %>" hidden>
    <div class="wrap">
      <p>
        <strong>The Terms and Privacy Policy changed on <%= legalNotice.date %>.</strong>
        Carrying on using <%= rp ? 'RaidProtector' : 'BotApprove' %> means you accept them.
        <a href="<%= termsHref %>">Read the Terms</a> and the
        <a href="<%= privacyHref %>">Privacy Policy</a>.
      </p>
      <button type="button" id="legal-notice-close" aria-label="Dismiss">Got it</button>
    </div>
  </div>
<% } %>
