<% if (typeof legalNotice !== 'undefined' && legalNotice) { %>
  <%
    const rp = (typeof product !== 'undefined' ? product : '') === 'raidprotector';
    const termsHref = rp ? '/raidprotector/terms' : '/terms';
    const privacyHref = rp ? '/raidprotector/privacy' : '/privacy';
  %>
  <div class="legal-notice" id="legal-notice" data-version="<%= legalNotice.version %>" hidden>
    <div class="wrap">
      <p>
        <strong>The Terms and Privacy Policy changed on <%= legalNotice.date %>.</strong>
        Carrying on using <%= rp ? 'RaidProtector' : 'BotApprove' %> means you accept them.
        <a href="<%= termsHref %>">Read the Terms</a> and the
        <a href="<%= privacyHref %>">Privacy Policy</a>.
      </p>
      <button type="button" id="legal-notice-close" aria-label="Dismiss">Got it</button>
    </div>
  </div>
  <script>
    // Hidden in the markup and shown by script, so a reader whose browser has
    // already dismissed this version never sees it appear and vanish. The
    // version is the date of the change, so the next one shows again rather
    // than staying dismissed forever.
    (function () {
      var el = document.getElementById('legal-notice');
      if (!el) return;
      var key = 'botapprove.legal-seen';
      var version = el.getAttribute('data-version');
      try {
        if (localStorage.getItem(key) === version) return;
      } catch (e) { /* private mode, show it */ }
      el.hidden = false;
      var btn = document.getElementById('legal-notice-close');
      if (btn) {
        btn.addEventListener('click', function () {
          el.hidden = true;
          try { localStorage.setItem(key, version); } catch (e) { /* nothing to do */ }
        });
      }
    }());
  </script>
<% } %>
